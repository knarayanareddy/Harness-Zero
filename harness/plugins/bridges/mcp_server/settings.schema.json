{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "MCP server bridge settings",
  "x-namespace": "plugins.bridge-mcp-server",
  "properties": {
    "expose": {
      "type": "array",
      "default": [],
      "title": "Tools Exposed Over MCP",
      "x-ui": {
        "widget": "json"
      },
      "description": "Tool names this daemon offers to external MCP hosts. Empty means nothing is exposed.",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "x-alias-namespaces": {
    "plugins.mcp-server": {
      "expose": "expose"
    }
  }
}
