{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "base_url": {
      "type": "string",
      "default": "https://api.openai.com/v1",
      "description": "Base URL for OpenAI completions API"
    },
    "timeout_s": {
      "type": "number",
      "default": 60.0,
      "minimum": 1.0,
      "description": "Request timeout in seconds"
    },
    "default_model": {
      "type": "string",
      "default": "gpt-4o",
      "description": "Default model ID"
    }
  }
}
