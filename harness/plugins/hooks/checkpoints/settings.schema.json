{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Workspace checkpoint settings",
  "x-namespace": "plugins.hook-checkpoints",
  "additionalProperties": false,
  "properties": {
    "max_files": {
      "type": "integer",
      "default": 200,
      "minimum": 1,
      "maximum": 2000,
      "description": "Maximum changed-file rows shown in one turn summary.",
      "x-ui": {"title": "Maximum diff files", "group": "Checkpoints", "order": 10}
    },
    "max_diff_bytes": {
      "type": "integer",
      "default": 262144,
      "minimum": 1024,
      "maximum": 10485760,
      "description": "Maximum bytes returned for one on-demand file diff.",
      "x-ui": {"title": "Maximum diff size", "group": "Checkpoints", "order": 20}
    },
    "max_workspace_bytes": {
      "type": "integer",
      "default": 67108864,
      "minimum": 1048576,
      "maximum": 1073741824,
      "description": "Skip checkpoint snapshots when Git-visible workspace files exceed this size; a system notice is recorded.",
      "x-ui": {"title": "Snapshot size limit", "group": "Checkpoints", "order": 30}
    }
  }
}
