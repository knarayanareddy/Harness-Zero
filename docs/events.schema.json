{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessZeroEventEnvelope",
  "type": "object",
  "required": [
    "type",
    "id",
    "ts",
    "data"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "approval.required",
        "approval.resolved",
        "compaction.completed",
        "compaction.started",
        "context.assembled",
        "cost.updated",
        "hook.fired",
        "model.completed",
        "model.notice",
        "model.started",
        "model.text.delta",
        "model.thinking.delta",
        "model.tool_call",
        "plugin.error",
        "plugin.loaded",
        "session.started",
        "session.switched",
        "settings.changed",
        "task.completed",
        "task.started",
        "tool.call",
        "tool.decision",
        "tool.output.delta",
        "tool.repeat_detected",
        "tool.result",
        "tool.result.pruned",
        "turn.cancelled",
        "turn.completed",
        "turn.error",
        "turn.started",
        "ui.card"
      ],
      "description": "Event topic identifier"
    },
    "id": {
      "type": "string",
      "description": "Unique event identifier"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of event creation"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Session identifier if correlated"
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Turn identifier if correlated"
    },
    "data": {
      "type": "object",
      "description": "Event-specific payload; see $defs/payloads/<type>"
    },
    "record": {
      "type": [
        "object",
        "null"
      ],
      "description": "Transcript record this event mirrors, as stored (durable types only)"
    }
  },
  "events": {
    "approval.required": {
      "payload": "ApprovalRequired",
      "durable": false,
      "record_kind": null,
      "transient": false
