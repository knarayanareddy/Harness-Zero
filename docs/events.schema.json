  "$defs": {
    "ContextBlockInfo": {
      "title": "ContextBlockInfo",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "stability": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "tokens": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "stability",
        "source",
        "tokens"
      ],
      "description": "One assembled context block (nested in ``context.assembled``)."
    },
    "Usage": {
      "title": "Usage",
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "cache_read_tokens": {
          "type": "integer"
        },
        "cache_write_tokens": {
          "type": "integer"
        },
        "reasoning_tokens": {
          "type": "integer"
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "payloads": {
      "approval.required": {
        "title": "ApprovalRequired",
        "type": "object",
        "properties": {
          "approval_id": {
            "type": "string"
          },
          "call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "object"
          },
          "timeout_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "approval_id",
          "call_id",
          "kind",
          "summary",
          "details",
          "timeout_s",
          "options"
        ]
      },
      "approval.resolved": {
        "title": "ApprovalResolved",
        "type": "object",
        "properties": {
          "approval_id": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "by": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "approval_id",
          "approved",
          "by"
        ]
      },
      "compaction.completed": {
        "title": "CompactionCompleted",
        "type": "object",
        "properties": {
          "summary_tokens": {
            "type": "integer"
          },
          "duration_ms": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "required": [
          "summary_tokens",
          "duration_ms"
        ]
      },
      "compaction.started": {
        "title": "CompactionStarted",
        "type": "object",
        "properties": {
          "estimated_tokens": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
          "estimated_tokens"
        ]
      },
      "context.assembled": {
        "title": "ContextAssembled",
        "type": "object",
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ContextBlockInfo"
            }
          },
          "total_tokens": {
            "type": "integer"
          },
          "history_messages": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
          "blocks",
          "total_tokens",
          "history_messages"
        ]
      },
      "cost.updated": {
        "title": "CostUpdated",
        "type": "object",
        "properties": {
          "turn_usd": {
            "type": "number"
          },
          "session_usd": {
            "type": "number"
          },
          "lifetime_usd": {
            "type": "number"
          },
          "cap_usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "unknown_pricing": {
            "type": "boolean"
          },
          "usage": {
            "$ref": "#/$defs/Usage"
          }
        },
        "additionalProperties": false,
        "description": "``cost.updated`` carries the same ``EconomicsSnapshot`` the ``economics`` command returns."
      },
      "hook.fired": {
        "title": "HookFired",
        "type": "object",
        "properties": {
          "hook": {
