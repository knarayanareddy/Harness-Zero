    },
    "id": {
      "type": "string",
      "description": "Unique event identifier"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of event creation"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Session identifier if correlated"
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Turn identifier if correlated"
    },
    "data": {
      "type": "object",
      "description": "Event-specific payload; see $defs/payloads/<type>"
    },
    "record": {
      "type": [
        "object",
        "null"
      ],
      "description": "Transcript record this event mirrors, as stored (durable types only)"
    }
  },
